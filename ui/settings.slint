import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    ScrollView,
    Slider,
    SpinBox,
    Switch,
    Palette,
} from "std-widgets.slint";

export struct ProfileItem {
    id: int,
    name: string,
    polling: string,
    dpi: string,
    app: string,
    badge: string,
    is-default: bool,
}

export struct DpiGearItem {
    index: int,
    value: string,
    active: bool,
}

component SideNavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();

    height: 42px;
    border-radius: 6px;
    background: selected ? Palette.control-background : (touch.has-hover ? Palette.control-background.with-alpha(0.55) : transparent);

    Rectangle {
        visible: root.selected;
        x: 0;
        y: 9px;
        width: 3px;
        height: root.height - 18px;
        border-radius: 2px;
        background: Palette.accent-background;
    }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 10px;
        spacing: 12px;
        cross-axis-alignment: center;

        Text {
            width: 22px;
            text: root.glyph;
            color: root.selected ? Palette.accent-background : Palette.foreground;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsCard inherits Rectangle {
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> last;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 74px;
    background: transparent;

    VerticalLayout {
        width: root.width - 76px;
        padding-top: 11px;
        padding-bottom: 9px;
        spacing: 4px;
        Text {
            text: root.title;
            color: Palette.foreground;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: left;
        }
        Text {
            text: root.description;
            color: Palette.foreground.with-alpha(0.62);
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: left;
        }
    }

    Switch {
        x: root.width - self.width;
        y: 18px;
        checked <=> root.checked;
        toggled => { root.toggled(root.checked); }
    }

    Rectangle {
        visible: !root.last;
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Palette.border.with-alpha(0.45);
    }
}

component FieldLabel inherits Text {
    color: Palette.foreground.with-alpha(0.68);
    font-size: 12px;
    vertical-alignment: center;
}

component StatusDot inherits Rectangle {
    in property <bool> good;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.good ? #0F7B0F : #C42B1C;
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 5px;

    Text {
        text: root.title;
        color: Palette.foreground;
        font-size: 25px;
        font-weight: 600;
    }
    Text {
        text: root.subtitle;
        color: Palette.foreground.with-alpha(0.62);
        font-size: 13px;
    }
}

export component MainWindow inherits Window {
    title: "rapoo-tray 设置";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 1020px;
    min-height: 700px;
    background: Palette.background;

    in-out property <int> page: 0;

    in property <string> device-name: "雷柏 VT3 V2";
    in property <string> device-mode: "2.4G 无线";
    in property <bool> connected: true;
    in property <int> battery: 100;
    in property <int> device-dpi-x: 1000;
    in property <int> device-dpi-y: 1000;
    in property <int> device-dpi-index: 0;
    in property <string> model-label: "雷柏 VT3 V2";

    in-out property <string> status-text: "选择配置进行编辑，或新增一个配置";
    in-out property <bool> status-good: true;

    in property <[ProfileItem]> profiles: [
        { id: 1, name: "日常", polling: "1000 Hz", dpi: "1000", app: "—", badge: "当前", is-default: true },
        { id: 2, name: "高性能", polling: "4000 Hz", dpi: "1600", app: "—", badge: "默认", is-default: false },
    ];
    in-out property <int> selected-profile-id: 1;
    in-out property <string> profile-name: "日常";
    in-out property <int> profile-poll-index: 3;
    in-out property <int> profile-sleep: 10;
    in-out property <int> profile-dpi-x: 1000;
    in-out property <int> profile-dpi-y: 1000;
    in-out property <string> profile-app-path: "";
    in-out property <bool> profile-is-default: true;
    in-out property <bool> profile-dirty: false;
    in-out property <bool> profile-loading: false;

    in property <[string]> polling-options: ["125 Hz", "250 Hz", "500 Hz", "1000 Hz", "2000 Hz", "4000 Hz", "8000 Hz"];

    in-out property <bool> auto-switch-enabled: true;
    in-out property <bool> auto-run-enabled: false;
    in-out property <bool> osd-enabled: true;
    in-out property <bool> rf-full: false;
    in-out property <int> model-index: 0;
    in-out property <bool> model-loading: false;
    in property <[string]> model-options: ["雷柏 VT3 V2", "雷柏 VT7", "雷柏 VT3 MAX", "雷柏 VT3S", "通用鼠标"];

    in property <[DpiGearItem]> dpi-gears: [
        { index: 0, value: "1000", active: true },
    ];
    in-out property <int> selected-dpi-index: 0;
    in-out property <int> dpi-x: 1000;
    in-out property <int> dpi-y: 1000;
    in-out property <bool> dpi-independent: false;
    in property <int> dpi-min: 10;
    in property <int> dpi-max: 30000;
    in property <int> dpi-step: 10;
    in property <int> dpi-active-index: 0;
    in-out property <bool> dpi-dirty: false;
    in-out property <bool> dpi-loading: false;

    in-out property <string> about-version: "1.6.8";
    in-out property <string> update-status: "检查 GitHub Releases 上是否有新版本";
    in-out property <string> update-button-text: "检查更新";
    in-out property <bool> update-busy: false;

    callback page-changed(int);
    callback profile-selected(int);
    callback profile-add();
    callback profile-delete();
    callback profile-save();
    callback profile-browse();
    callback profile-clear-app();
    callback profile-capture-dpi();
    callback auto-switch-changed(bool);
    callback startup-changed(bool);
    callback osd-changed(bool);
    callback rf-changed(bool);
    callback model-changed(int);
    callback dpi-gear-selected(int);
    callback dpi-gear-add();
    callback dpi-gear-delete();
    callback dpi-values-edited();
    callback dpi-apply();
    callback check-update();
    callback open-source();
    callback close-window();
    callback refresh-tick();

    function go(page-index: int) {
        root.page = page-index;
        root.page-changed(page-index);
    }

    function mark-profile-dirty() {
        if root.profile-loading { return; }
        root.profile-dirty = true;
        root.status-text = "有未保存的更改";
        root.status-good = true;
    }

    function mark-dpi-dirty() {
        if root.dpi-loading { return; }
        root.dpi-dirty = true;
        root.status-text = "DPI 修改尚未写入鼠标";
        root.status-good = true;
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: 236px;
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding-top: 22px;
                    padding-right: 14px;
                    padding-bottom: 18px;
                    padding-left: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 11px;
                        padding-left: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: @linear-gradient(135deg, #6D28D9 0%, #9B6CFF 54%, #E9D5FF 100%);
                            Text {
                                text: "R";
                                color: white;
                                font-size: 17px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;
                            cross-axis-alignment: center;
                            Text {
                                text: "rapoo-tray";
                                color: Palette.foreground;
                                font-size: 16px;
                                font-weight: 600;
                            }
                            Text {
                                text: "雷柏鼠标控制";
                                color: Palette.foreground.with-alpha(0.58);
                                font-size: 11px;
                            }
                        }
                    }

                    Rectangle { height: 12px; background: transparent; }

                    Text {
                        text: "设置";
                        color: Palette.foreground.with-alpha(0.5);
                        font-size: 11px;
                        font-weight: 600;
                    }

                    SideNavItem {
                        label: "配置档案";
                        glyph: "◫";
                        selected: root.page == 0;
                        clicked => { root.go(0); }
                    }
                    SideNavItem {
                        label: "自动化";
                        glyph: "⚡";
                        selected: root.page == 1;
                        clicked => { root.go(1); }
                    }
                    SideNavItem {
                        label: "DPI 档位";
                        glyph: "◉";
                        selected: root.page == 2;
                        clicked => { root.go(2); }
                    }
                    SideNavItem {
                        label: "关于";
                        glyph: "i";
                        selected: root.page == 3;
                        clicked => { root.go(3); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 74px;
                        border-radius: 7px;
                        background: Palette.background.with-alpha(0.58);
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            padding-top: 10px;
                            padding-right: 12px;
                            padding-bottom: 10px;
                            padding-left: 12px;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 7px;
                                cross-axis-alignment: center;
                                StatusDot { good: root.connected; }
                                Text {
                                    text: root.connected ? "设备已连接" : "设备未连接";
                                    color: Palette.foreground;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                            Text {
                                text: root.device-name + " · " + root.battery + "%";
                                color: Palette.foreground.with-alpha(0.6);
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;

                VerticalLayout {
                    HorizontalLayout {
                        height: 104px;
                        padding-top: 24px;
                        padding-right: 30px;
                        padding-bottom: 14px;
                        padding-left: 30px;
                        cross-axis-alignment: center;
                        spacing: 18px;

                        PageTitle {
                            horizontal-stretch: 1;
                            title: root.page == 0 ? "配置档案" : root.page == 1 ? "自动化" : root.page == 2 ? "DPI 档位" : "关于";
                            subtitle: root.page == 0 ? "为不同应用保存回报率、DPI、休眠和启动规则" : root.page == 1 ? "管理前台程序联动、悬浮提示与设备策略" : root.page == 2 ? "编辑鼠标内建 DPI 档位并安全写入设备" : "版本信息、项目源码与更新检查";
                        }

                        Rectangle {
                            height: 36px;
                            border-radius: 18px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding-left: 13px;
                                padding-right: 14px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                StatusDot { good: root.connected; }
                                Text {
                                    text: root.connected ? root.device-mode + "  ·  " + root.battery + "%" : "等待设备连接";
                                    color: Palette.foreground.with-alpha(0.75);
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                        clip: true;

                        if root.page == 0 : HorizontalLayout {
                            padding-top: 0px;
                            padding-right: 30px;
                            padding-bottom: 18px;
                            padding-left: 30px;
                            spacing: 18px;

                            SettingsCard {
                                width: 350px;
                                VerticalLayout {
                                    padding-top: 20px;
                                    padding-right: 18px;
                                    padding-bottom: 16px;
                                    padding-left: 18px;
                                    spacing: 13px;
                                    HorizontalLayout {
                                        Text {
                                            text: "所有配置";
                                            color: Palette.foreground;
                                            font-size: 16px;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.profiles.length;
                                            color: Palette.foreground.with-alpha(0.5);
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    ListView {
                                        vertical-stretch: 1;
                                        for item[i] in root.profiles : Rectangle {
                                            height: 68px;
                                            border-radius: 6px;
                                            background: item.id == root.selected-profile-id ? Palette.control-background : (profile-touch.has-hover ? Palette.control-background.with-alpha(0.45) : transparent);
                                            border-width: item.id == root.selected-profile-id ? 1px : 0px;
                                            border-color: Palette.border;

                                            HorizontalLayout {
                                                padding-top: 10px;
                                                padding-right: 11px;
                                                padding-bottom: 10px;
                                                padding-left: 11px;
                                                spacing: 9px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 4px;
                                                    cross-axis-alignment: start;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Text {
                                                            text: item.name;
                                                            color: Palette.foreground;
                                                            font-size: 14px;
                                                            font-weight: 600;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                        if !item.badge.is-empty : Rectangle {
                                                            width: 44px;
                                                            height: 20px;
                                                            border-radius: 10px;
                                                            background: item.badge == "当前" ? Palette.accent-background.with-alpha(0.14) : Palette.control-background;
                                                            Text {
                                                                text: item.badge;
                                                                color: item.badge == "当前" ? Palette.accent-background : Palette.foreground.with-alpha(0.64);
                                                                font-size: 10px;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: item.polling + "  ·  " + item.dpi + " DPI  ·  " + item.app;
                                                        color: Palette.foreground.with-alpha(0.55);
                                                        font-size: 11px;
                                                        overflow: elide;
                                                    }
                                                }
                                                Text {
                                                    text: "›";
                                                    color: Palette.foreground.with-alpha(0.35);
                                                    font-size: 20px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            profile-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.profile-selected(item.id); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "新建";
                                            horizontal-stretch: 1;
                                            clicked => { root.profile-add(); }
                                        }
                                        Button {
                                            text: "删除";
                                            enabled: root.profiles.length > 1;
                                            horizontal-stretch: 1;
                                            clicked => { root.profile-delete(); }
                                        }
                                    }
                                }
                            }

                            SettingsCard {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding-top: 20px;
                                    padding-right: 22px;
                                    padding-bottom: 16px;
                                    padding-left: 22px;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        Text {
                                            text: "配置详情";
                                            color: Palette.foreground;
                                            font-size: 16px;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            visible: root.profile-dirty;
                                            text: "未保存";
                                            color: #C27A00;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 5px;
                                        FieldLabel { text: "名称"; }
                                        LineEdit {
                                            text <=> root.profile-name;
                                            placeholder-text: "配置名称";
                                            edited(text) => { root.profile-name = text; root.mark-profile-dirty(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            FieldLabel { text: "回报率"; }
                                            ComboBox {
                                                current-index <=> root.profile-poll-index;
                                                model: root.polling-options;
                                                changed current-index => { if !root.profile-loading { root.mark-profile-dirty(); } }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            FieldLabel { text: "休眠时间（分钟）"; }
                                            SpinBox {
                                                minimum: 5;
                                                maximum: 60;
                                                step-size: 5;
                                                value <=> root.profile-sleep;
                                                edited(value) => { root.profile-sleep = value; root.mark-profile-dirty(); }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 5px;
                                        FieldLabel { text: "关联程序（进入前台时自动切换）"; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                text <=> root.profile-app-path;
                                                placeholder-text: "可选：选择 .exe 文件";
                                                horizontal-stretch: 1;
                                                edited(text) => { root.profile-app-path = text; root.mark-profile-dirty(); }
                                            }
                                            Button {
                                                text: "浏览";
                                                clicked => { root.profile-browse(); }
                                            }
                                            Button {
                                                text: "清除";
                                                enabled: !root.profile-app-path.is-empty;
                                                clicked => { root.profile-clear-app(); }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Palette.border.with-alpha(0.55); }

                                    HorizontalLayout {
                                        Text {
                                            text: "配置 DPI";
                                            color: Palette.foreground;
                                            font-size: 14px;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: "随配置一起切换";
                                            color: Palette.foreground.with-alpha(0.5);
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            FieldLabel { text: "X 轴"; }
                                            SpinBox {
                                                minimum: 10;
                                                maximum: 60000;
                                                step-size: 10;
                                                value <=> root.profile-dpi-x;
                                                edited(value) => { root.profile-dpi-x = value; root.mark-profile-dirty(); }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            FieldLabel { text: "Y 轴"; }
                                            SpinBox {
                                                minimum: 10;
                                                maximum: 60000;
                                                step-size: 10;
                                                value <=> root.profile-dpi-y;
                                                edited(value) => { root.profile-dpi-y = value; root.mark-profile-dirty(); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 5px;
                                            FieldLabel { text: " "; }
                                            Button {
                                                text: "读取当前";
                                                clicked => { root.profile-capture-dpi(); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 36px;
                                        spacing: 8px;
                                        CheckBox {
                                            checked <=> root.profile-is-default;
                                            text: "设为默认配置（离开关联程序后恢复）";
                                            toggled => { root.mark-profile-dirty(); }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: transparent; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "切换配置会一次性应用回报率、休眠与 DPI";
                                            color: Palette.foreground.with-alpha(0.5);
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Button {
                                            text: root.profile-dirty ? "保存并应用" : "已保存";
                                            primary: root.profile-dirty;
                                            enabled: root.profile-dirty;
                                            clicked => { root.profile-save(); }
                                        }
                                    }
                                }
                            }
                        }

                        if root.page == 1 : ScrollView {
                            VerticalLayout {
                                padding-right: 30px;
                                padding-bottom: 18px;
                                padding-left: 30px;
                                spacing: 16px;
                                SettingsCard {
                                    width: 100%;
                                    VerticalLayout {
                                        padding-top: 4px;
                                        padding-right: 20px;
                                        padding-bottom: 4px;
                                        padding-left: 20px;
                                        SettingRow {
                                            title: "前台程序自动切换";
                                            description: "进入关联程序时自动应用对应配置，离开后恢复默认配置。";
                                            last: false;
                                            checked: root.auto-switch-enabled;
                                            toggled(value) => { root.auto-switch-enabled = value; root.auto-switch-changed(value); }
                                        }
                                        SettingRow {
                                            title: "悬浮窗提示";
                                            description: "在 DPI、连接状态和配置切换时显示轻量 OSD。";
                                            last: false;
                                            checked: root.osd-enabled;
                                            toggled(value) => { root.osd-enabled = value; root.osd-changed(value); }
                                        }
                                        SettingRow {
                                            title: "开机自启动";
                                            description: "登录 Windows 后自动启动托盘程序。";
                                            last: true;
                                            checked: root.auto-run-enabled;
                                            toggled(value) => { root.auto-run-enabled = value; root.startup-changed(value); }
                                        }
                                    }
                                }

                                SettingsCard {
                                    width: 100%;
                                    height: 160px;
                                    VerticalLayout {
                                        padding-top: 18px;
                                        padding-right: 20px;
                                        padding-bottom: 18px;
                                        padding-left: 20px;
                                        spacing: 10px;
                                        Text {
                                            text: "设备与续航";
                                            color: Palette.foreground;
                                            font-size: 16px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "型号会用于续航估算和 DPI 范围校验。";
                                            color: Palette.foreground.with-alpha(0.58);
                                            font-size: 12px;
                                        }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 5px;
                                                FieldLabel { text: "鼠标型号"; }
                                                ComboBox {
                                                    current-index <=> root.model-index;
                                                    model: root.model-options;
                                                    changed current-index => { if !root.model-loading { root.model-changed(self.current-index); } }
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 5px;
                                                FieldLabel { text: "射频策略"; }
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    Switch {
                                                        checked <=> root.rf-full;
                                                        toggled => { root.rf-changed(self.checked); }
                                                    }
                                                    Text {
                                                        text: root.rf-full ? "满格射频（功耗较高）" : "智能调节（推荐）";
                                                        color: Palette.foreground;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                SettingsCard {
                                    width: 100%;
                                    height: 128px;
                                    VerticalLayout {
                                        padding-top: 18px;
                                        padding-right: 20px;
                                        padding-bottom: 18px;
                                        padding-left: 20px;
                                        spacing: 8px;
                                        Text {
                                            text: "当前设备";
                                            color: Palette.foreground;
                                            font-size: 16px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 30px;
                                            Text { text: "型号  " + root.model-label; color: Palette.foreground.with-alpha(0.7); font-size: 12px; }
                                            Text { text: "连接  " + root.device-mode; color: Palette.foreground.with-alpha(0.7); font-size: 12px; }
                                            Text { text: "电量  " + root.battery + "%"; color: Palette.foreground.with-alpha(0.7); font-size: 12px; }
                                            Text { text: "DPI  " + root.device-dpi-x + (root.device-dpi-x == root.device-dpi-y ? "" : " × " + root.device-dpi-y); color: Palette.foreground.with-alpha(0.7); font-size: 12px; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.page == 2 : HorizontalLayout {
                            padding-top: 0px;
                            padding-right: 30px;
                            padding-bottom: 18px;
                            padding-left: 30px;
                            spacing: 18px;

                            SettingsCard {
                                width: 320px;
                                VerticalLayout {
                                    padding-top: 20px;
                                    padding-right: 18px;
                                    padding-bottom: 16px;
                                    padding-left: 18px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        Text {
                                            text: "DPI 档位";
                                            color: Palette.foreground;
                                            font-size: 16px;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.dpi-gears.length + " / " + 7;
                                            color: Palette.foreground.with-alpha(0.5);
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.dpi-min + "–" + root.dpi-max + " DPI · 步进 " + root.dpi-step + " · 最多 7 档";
                                        color: Palette.foreground.with-alpha(0.56);
                                        font-size: 11px;
                                    }

                                    ListView {
                                        vertical-stretch: 1;
                                        for gear[i] in root.dpi-gears : Rectangle {
                                            height: 48px;
                                            border-radius: 6px;
                                            background: gear.index == root.selected-dpi-index ? Palette.accent-background.with-alpha(0.12) : (gear-touch.has-hover ? Palette.control-background.with-alpha(0.5) : transparent);
                                            border-width: gear.index == root.selected-dpi-index ? 1px : 0px;
                                            border-color: Palette.accent-background.with-alpha(0.48);

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 12px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: (i + 1) + "";
                                                    width: 24px;
                                                    color: Palette.foreground.with-alpha(0.45);
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: gear.value;
                                                    color: Palette.foreground;
                                                    font-size: 14px;
                                                    font-weight: gear.index == root.selected-dpi-index ? 600 : 400;
                                                    horizontal-stretch: 1;
                                                }
                                                if gear.active : Text {
                                                    text: "当前";
                                                    color: Palette.accent-background;
                                                    font-size: 11px;
                                                }
                                            }
                                            gear-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.dpi-gear-selected(gear.index); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "+ 添加";
                                            horizontal-stretch: 1;
                                            enabled: root.dpi-gears.length < 7;
                                            clicked => { root.dpi-gear-add(); }
                                        }
                                        Button {
                                            text: "删除";
                                            horizontal-stretch: 1;
                                            enabled: root.dpi-gears.length > 1;
                                            clicked => { root.dpi-gear-delete(); }
                                        }
                                    }
                                }
                            }

                            SettingsCard {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding-top: 20px;
                                    padding-right: 22px;
                                    padding-bottom: 16px;
                                    padding-left: 22px;
                                    spacing: 14px;
                                    Text {
                                        text: "第 " + (root.selected-dpi-index + 1) + " 档";
                                        color: Palette.foreground;
                                        font-size: 17px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.connected ? ("鼠标当前第 " + (root.dpi-active-index + 1) + " 档使用 " + root.device-dpi-x + " DPI") : "鼠标未连接，可先保存到本机缓存";
                                        color: Palette.foreground.with-alpha(0.6);
                                        font-size: 12px;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            FieldLabel { text: "横向 X"; }
                                            SpinBox {
                                                minimum: root.dpi-min;
                                                maximum: root.dpi-max;
                                                step-size: root.dpi-step;
                                                value: root.dpi-x * 1.0;
                                                edited(value) => {
                                                    root.dpi-x = value;
                                                    if !root.dpi-independent { root.dpi-y = value; }
                                                    root.mark-dpi-dirty();
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            FieldLabel { text: "纵向 Y"; }
                                            SpinBox {
                                                minimum: root.dpi-min;
                                                maximum: root.dpi-max;
                                                step-size: root.dpi-step;
                                                value <=> root.dpi-y;
                                                enabled: root.dpi-independent;
                                                edited(value) => { root.dpi-y = value; root.mark-dpi-dirty(); }
                                            }
                                        }
                                    }

                                    CheckBox {
                                        checked <=> root.dpi-independent;
                                        text: "横向 X 与纵向 Y 独立设置";
                                        toggled => {
                                            if !self.checked { root.dpi-y = root.dpi-x; }
                                            root.mark-dpi-dirty();
                                        }
                                    }

                                    Slider {
                                        minimum: root.dpi-min;
                                        maximum: root.dpi-max;
                                        step: root.dpi-step;
                                        value: root.dpi-x * 1.0;
                                        changed value => {
                                            if !root.dpi-independent { root.dpi-y = round(self.value); }
                                            root.mark-dpi-dirty();
                                        }
                                    }

                                    Rectangle {
                                        height: 92px;
                                        border-radius: 7px;
                                        background: Palette.background.with-alpha(0.46);
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        VerticalLayout {
                                            padding-top: 12px;
                                            padding-right: 15px;
                                            padding-bottom: 12px;
                                            padding-left: 15px;
                                            spacing: 5px;
                                            Text {
                                                text: "安全写入";
                                                color: Palette.foreground;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "编辑只会修改当前视图；点击“应用并切换”后才会写入鼠标并保存本机缓存。";
                                                color: Palette.foreground.with-alpha(0.58);
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: transparent; }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: root.dpi-dirty ? "有尚未写入的修改" : "当前档位与设备同步";
                                            color: root.dpi-dirty ? #C27A00 : Palette.foreground.with-alpha(0.54);
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Button {
                                            text: "应用并切换";
                                            primary: true;
                                            clicked => { root.dpi-apply(); }
                                        }
                                    }
                                }
                            }
                        }

                        if root.page == 3 : ScrollView {
                            VerticalLayout {
                                padding-right: 30px;
                                padding-bottom: 18px;
                                padding-left: 30px;
                                spacing: 16px;

                                SettingsCard {
                                    width: 100%;
                                    height: 214px;
                                    HorizontalLayout {
                                        padding: 28px;
                                        spacing: 24px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 116px;
                                            height: 116px;
                                            border-radius: 22px;
                                            background: @linear-gradient(135deg, #4C1D95 0%, #7C3AED 45%, #C4B5FD 100%);
                                            Text {
                                                text: "R";
                                                color: white;
                                                font-size: 54px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 9px;
                                            cross-axis-alignment: start;
                                            Text {
                                                text: "rapoo-tray";
                                                color: Palette.foreground;
                                                font-size: 28px;
                                                font-weight: 600;
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 86px;
                                                    height: 26px;
                                                    border-radius: 13px;
                                                    background: Palette.control-background;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    Text {
                                                        text: "版本 " + root.about-version;
                                                        color: Palette.foreground.with-alpha(0.72);
                                                        font-size: 11px;
                                                        padding-left: 10px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: "轻量 · 原生 · 开源";
                                                    color: Palette.foreground.with-alpha(0.52);
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: "雷柏 VT 系列游戏鼠标托盘工具";
                                                color: Palette.foreground.with-alpha(0.64);
                                                font-size: 13px;
                                            }
                                        }
                                    }
                                }

                                SettingsCard {
                                    width: 100%;
                                    height: 132px;
                                    HorizontalLayout {
                                        padding-top: 20px;
                                        padding-right: 22px;
                                        padding-bottom: 20px;
                                        padding-left: 22px;
                                        spacing: 20px;
                                        cross-axis-alignment: center;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            Text {
                                                text: "项目源码";
                                                color: Palette.foreground;
                                                font-size: 14px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "github.com/Rimliya/rapoo-tray";
                                                color: Palette.accent-background;
                                                font-size: 12px;
                                            }
                                        }
                                        Button {
                                            text: "打开 GitHub";
                                            clicked => { root.open-source(); }
                                        }
                                    }
                                }

                                SettingsCard {
                                    width: 100%;
                                    height: 146px;
                                    VerticalLayout {
                                        padding-top: 20px;
                                        padding-right: 22px;
                                        padding-bottom: 20px;
                                        padding-left: 22px;
                                        spacing: 9px;
                                        Text {
                                            text: "软件更新";
                                            color: Palette.foreground;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.update-status;
                                            color: Palette.foreground.with-alpha(0.62);
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                        HorizontalLayout {
                                            alignment: end;
                                            Button {
                                                text: root.update-button-text;
                                                enabled: !root.update-busy;
                                                primary: true;
                                                clicked => { root.check-update(); }
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 10px; background: transparent; }
                                Text {
                                    text: "MIT License · © 2026 Iris · Slint Fluent UI";
                                    color: Palette.foreground.with-alpha(0.42);
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 58px;
                        background: Palette.alternate-background;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding-top: 10px;
                            padding-right: 22px;
                            padding-bottom: 10px;
                            padding-left: 30px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            StatusDot { good: root.status-good; }
                            Text {
                                text: root.status-text;
                                color: Palette.foreground.with-alpha(0.66);
                                font-size: 11px;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "关闭";
                                clicked => { root.close-window(); }
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 1s;
        running: true;
        triggered => { root.refresh-tick(); }
    }
}


