<Application x:Class="RapooTray.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#4D525A" />
      <SolidColorBrush x:Key="AppCardSurfaceBrush" Color="#FCFCFD" />
      <SolidColorBrush x:Key="AppSoftAccentSurfaceBrush" Color="#F3F7FF" />
      <SolidColorBrush x:Key="AppTertiaryTextBrush" Color="#676C75" />
      <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#26000000" />
      <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#10000000" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
