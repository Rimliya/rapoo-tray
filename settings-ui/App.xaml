<Application x:Class="RapooTray.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

      <FontFamily x:Key="AppSairaFont">pack://application:,,,/rapoo-tray-settings;component/Assets/Fonts/#Rapoo Saira</FontFamily>
      <FontFamily x:Key="AppHarmonyFont">pack://application:,,,/rapoo-tray-settings;component/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>
      <FontFamily x:Key="AppHarmonyMediumFont">pack://application:,,,/rapoo-tray-settings;component/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>

      <SolidColorBrush x:Key="AppPaperBrush" Color="#EFF2F3" />
      <SolidColorBrush x:Key="AppPanelBrush" Color="#FCFDFD" />
      <SolidColorBrush x:Key="AppInkBrush" Color="#16191A" />
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#4E585C" />
      <SolidColorBrush x:Key="AppTertiaryTextBrush" Color="#626C70" />
      <SolidColorBrush x:Key="AppRuleBrush" Color="#D5DCDE" />
      <SolidColorBrush x:Key="AppChipBrush" Color="#E5EAEC" />
      <SolidColorBrush x:Key="AppSignalBrush" Color="#7DE6FF" />
      <SolidColorBrush x:Key="AppOnSignalBrush" Color="#161616" />
      <SolidColorBrush x:Key="AppTraceBrush" Color="#161616" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="AppCommandBarBrush" Color="#141718" />
      <SolidColorBrush x:Key="AppCommandBarTextBrush" Color="#F1F3F3" />
      <SolidColorBrush x:Key="AppCommandMutedBrush" Color="#AAB2B5" />
      <SolidColorBrush x:Key="AppCardSurfaceBrush" Color="#FCFDFD" />
      <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#D5DCDE" />
      <SolidColorBrush x:Key="AppSoftAccentSurfaceBrush" Color="#DDF5FA" />
      <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#E5EAEC" />

      <DrawingBrush x:Key="AppGridBrush" TileMode="Tile"
                    Viewport="0,0,72,72" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Geometry="M0,0 L72,0">
              <GeometryDrawing.Pen><Pen Brush="#07161616" Thickness="1" /></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M0,0 L0,72">
              <GeometryDrawing.Pen><Pen Brush="#07161616" Thickness="1" /></GeometryDrawing.Pen>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>

      <DrawingBrush x:Key="AppHatchBrush" TileMode="Tile"
                    Viewport="0,0,9.2,9.2" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Geometry="M0,9.2 L9.2,0">
              <GeometryDrawing.Pen><Pen Brush="#24161616" Thickness="1.5" /></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M-2.3,2.3 L2.3,-2.3">
              <GeometryDrawing.Pen><Pen Brush="#24161616" Thickness="1.5" /></GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M6.9,11.5 L11.5,6.9">
              <GeometryDrawing.Pen><Pen Brush="#24161616" Thickness="1.5" /></GeometryDrawing.Pen>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </ResourceDictionary>
  </Application.Resources>
</Application>
