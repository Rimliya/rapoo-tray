                  <StackPanel Grid.Column="2">
                    <TextBlock Text="射频策略" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal"><CheckBox x:Name="RfFullToggle" AutomationProperties.Name="满格射频策略" Style="{StaticResource SquareSwitchStyle}" Margin="0,0,10,0" Checked="RfFull_Changed" Unchecked="RfFull_Changed" /><TextBlock x:Name="RfStateText" Text="等待读取" FontSize="12" VerticalAlignment="Center" /><local:CutButton x:Name="RefreshRfButton" Content="读取策略" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0" Click="RefreshRf_Click" Visibility="Collapsed" /></StackPanel>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource AppRuleBrush}" Margin="22,0" />
                <Grid Margin="22,18,22,20">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="// CURRENT DEVICE" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="当前设备" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" /></StackPanel>
                  <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="型号" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="CurrentModelText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="连接" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="CurrentModeText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="电量" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="CurrentBatteryText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="DPI" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="CurrentDpiText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
          </ScrollViewer>
          <Grid x:Name="DpiPage" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="282" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="18,16,18,13">
                    <TextBlock Text="// SLOTS" Style="{StaticResource EyebrowStyle}" />
                    <Grid Margin="0,4,0,0"><TextBlock Text="DPI 档位" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="DpiCountText" Text="7 / 7" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" FontSize="13" /></Grid>
                    <TextBlock x:Name="DpiRangeText" Text="10–30000 DPI │ 步进 10 │ 最多 7 档" FontFamily="{StaticResource AppHarmonyFont}" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Row="0" Height="1" Margin="0,94,0,0" Background="{DynamicResource AppRuleBrush}" VerticalAlignment="Top" />
                  <ListBox x:Name="DpiSlotsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListCardItemStyle}" SelectionChanged="DpiSlotsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <Border x:Name="NumberTag" Width="28" Height="22" Background="{DynamicResource AppInkBrush}" VerticalAlignment="Center"><TextBlock x:Name="NumberText" Text="{Binding Index, StringFormat={}{0:00}}" FontFamily="{StaticResource AppSairaFont}" FontSize="11" Foreground="{DynamicResource AppPaperBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                          <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{StaticResource AppSairaFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppInkBrush}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Visibility="{Binding ActiveVisibility}" Padding="6,2" Background="{DynamicResource AppSignalBrush}"><TextBlock Text="当前" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppOnSignalBrush}" /></Border>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="NumberTag" Property="Background" Value="{DynamicResource AppSignalBrush}" /><Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource AppOnSignalBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid Grid.Row="2" Margin="14,10,14,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <local:CutButton x:Name="AddDpiButton" Content="添加档位" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Stretch" Click="AddDpi_Click" />
                    <local:CutButton x:Name="DeleteDpiButton" Grid.Column="2" Content="删除" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" Click="DeleteDpi_Click" />
                  </Grid>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource AppRuleBrush}" Margin="0,14,0,14" />
                <Grid Grid.Column="2" Margin="20,16,20,14">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="// SLOT EDITOR" Style="{StaticResource EyebrowStyle}" /><TextBlock x:Name="DpiPageTitle" Text="第 1 档" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" /><TextBlock x:Name="DpiPageSubtitle" Text="鼠标当前第 1 档使用 1600 DPI" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" /></StackPanel>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="// AXIS" Style="{StaticResource EyebrowStyle}" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="横向 X" Style="{StaticResource FieldLabelStyle}" /><local:FieldFrame Style="{StaticResource FieldFrameStyle}"><ui:NumberBox x:Name="DpiXBox" Style="{StaticResource EfNumberBoxStyle}" Minimum="10" Maximum="30000" SmallChange="10" MaxDecimalPlaces="0" ValueChanged="DpiValue_Changed" /></local:FieldFrame></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="纵向 Y" Style="{StaticResource FieldLabelStyle}" /><local:FieldFrame Style="{StaticResource FieldFrameStyle}"><ui:NumberBox x:Name="DpiYBox" Style="{StaticResource EfNumberBoxStyle}" Minimum="10" Maximum="30000" SmallChange="10" MaxDecimalPlaces="0" ValueChanged="DpiValue_Changed" /></local:FieldFrame></StackPanel>
                      </Grid>
                      <CheckBox x:Name="DpiIndependentCheck" Style="{StaticResource SquareCheckBoxStyle}" Content="横向 X 与纵向 Y 独立设置" Margin="0,16,0,18" Checked="DpiIndependent_Changed" Unchecked="DpiIndependent_Changed" />
                      <Slider x:Name="DpiSlider" Style="{StaticResource SquareSliderStyle}" Minimum="10" Maximum="30000" TickFrequency="10" ValueChanged="DpiSlider_ValueChanged" />
                      <Border BorderBrush="{DynamicResource AppInkBrush}" BorderThickness="1,0,0,0" Margin="0,24,0,0" Padding="12,10">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal"><Border Width="18" Height="18" Background="{DynamicResource AppSignalBrush}" Margin="0,0,8,0"><TextBlock Text="!" FontFamily="{StaticResource AppSairaFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppOnSignalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="安全写入" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel>
                          <TextBlock Text="编辑只会修改当前视图；点击“应用并切换”后才会写入鼠标并保存本机缓存。" Style="{StaticResource MutedTextStyle}" Margin="26,6,0,0" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                  <Border Grid.Row="2" BorderBrush="{DynamicResource AppRuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                    <Grid><TextBlock x:Name="DpiStatusText" Text="当前档位与设备同步" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><local:CutButton x:Name="ApplyDpiButton" Content="应用并切换" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="ApplyDpi_Click" /></Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <Grid Margin="22,22,22,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="92" Height="92" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppInkBrush}" BorderThickness="1" VerticalAlignment="Top"><Image Source="pack://application:,,,/rapoo-tray-settings;component/Assets/logo.png" Width="76" Height="76" Stretch="Uniform" /></Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="// ABOUT" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="rapoo-tray" FontFamily="{StaticResource AppSairaFont}" FontSize="28" FontWeight="ExtraBold" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Border Background="{DynamicResource AppSignalBrush}" Padding="7,3" Margin="0,0,10,0"><TextBlock x:Name="AboutVersionText" Text="版本 1.12.0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppOnSignalBrush}" /></Border><TextBlock Text="WPF 原生  /  开源" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="雷柏 VT 系列游戏鼠标托盘工具" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource AppRuleBrush}" />
                <Grid MinHeight="76" Margin="22,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="// SOURCE" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="项目源码" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock Text="github.com/Rimliya/rapoo-tray" FontFamily="{StaticResource AppSairaFont}" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel>
                  <local:CutButton Grid.Column="1" Content="打开 GitHub" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenSource_Click" />
                </Grid>
                <Border Height="1" Background="{DynamicResource AppRuleBrush}" Margin="22,0" />
                <Grid MinHeight="76" Margin="22,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="// UPDATE" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="软件更新" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="UpdateStatusText" Text="检查 GitHub Releases 上是否有新版本" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" /></StackPanel>
                  <local:CutButton x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="CheckUpdate_Click" />
                </Grid>
                <Border Height="1" Background="{DynamicResource AppRuleBrush}" Margin="22,0" />
                <Grid MinHeight="78" Margin="22,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="// TYPEFACE" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="HarmonyOS Sans SC" FontFamily="{StaticResource AppHarmonyFont}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="华为官方字体包 · HarmonyOS Sans Fonts License Agreement" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <local:CutButton Grid.Column="1" Content="查看字体许可" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="ShowFontLicense_Click" />
                </Grid>
                <Border Height="18" Background="{DynamicResource AppHatchBrush}" Margin="22,0" Opacity="0.55" />
                <Border Height="1" Background="{DynamicResource AppRuleBrush}" Margin="22,0" />
                <TextBlock Text="MIT License  │  © 2026 Rimliya  │  WPF UI" FontFamily="{StaticResource AppSairaFont}" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="22,15,22,20" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="FooterBar" Grid.Row="3" Background="{DynamicResource AppPaperBrush}" BorderBrush="{DynamicResource AppRuleBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="BusyTrack" Grid.Row="0" ClipToBounds="True" Background="Transparent">
          <Border x:Name="BusyScan" Width="96" HorizontalAlignment="Left" Background="{DynamicResource AppSignalBrush}" Opacity="0">
            <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
          </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="22,0,18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource AppTraceBrush}" Margin="0,0,9,0" />
            <TextBlock Text="// STATUS" Style="{StaticResource EyebrowStyle}" Margin="0,0,10,0" />
            <TextBlock x:Name="StatusText" Text="选择配置进行编辑，或新增一个配置" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <local:CutButton HorizontalAlignment="Right" VerticalAlignment="Center" Content="关闭" Style="{StaticResource SmallButtonStyle}" Click="Close_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
